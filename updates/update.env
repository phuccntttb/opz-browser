# Opz update server, read by scripts/release.sh (sourced by bash).
# Values already set in the environment win, e.g. for a local test:
#   OPZ_UPDATE_BASE_URL=http://localhost:8765 scripts/release.sh

# Base URL that installed copies of Opz check for updates. Each platform
# reads <base>/<BUILD_TARGET>/update.xml, e.g.
#   https://nas.example.lan/opz/Darwin_aarch64-gcc3/update.xml
#   https://nas.example.lan/opz/Linux_x86_64-gcc3/update.xml
# It is written into every release (distribution/policies.json, AppUpdateURL),
# so a release built with a wrong URL can only be fixed by a manual reinstall.
# The files are signed, so plain http works; https is still better.
OPZ_UPDATE_BASE_URL="${OPZ_UPDATE_BASE_URL:-https://opz-browser.vtpozt.link/updates}"

# Where "scripts/release.sh --publish" copies dist/release/site/ (rsync
# destination of the web root behind OPZ_UPDATE_BASE_URL), e.g.
#   user@nas.example.lan:/srv/www/opz
#   /Volumes/nas/www/opz
OPZ_UPDATE_PUBLISH="${OPZ_UPDATE_PUBLISH:-sg-1:/srv/opz/updates}"

# macOS signing (scripts/release.sh). Both empty: ad-hoc signature, and
# macOS blocks the app when the .dmg was downloaded with a browser.
# Developer ID Application certificate in the keychain, by name or SHA-1
# (security find-identity -v -p codesigning), e.g.
#   "Developer ID Application: Your Name (TEAMID1234)"
# or "auto": the one Developer ID Application identity in the keychain.
OPZ_MAC_SIGN_IDENTITY="${OPZ_MAC_SIGN_IDENTITY:-auto}"
# Prints the identity to sign with ("auto" resolved); extra arguments go to
# security find-identity (e.g. a keychain). Fails when "auto" finds none or
# several.
opz_mac_sign_identity() {
    if [ "$OPZ_MAC_SIGN_IDENTITY" != auto ]; then
        printf '%s\n' "$OPZ_MAC_SIGN_IDENTITY"
        return
    fi
    local ids n
    ids="$(security find-identity -v -p codesigning "$@" \
        | sed -n 's/.*"\(Developer ID Application: .*\)"$/\1/p' | sort -u)"
    n="$(printf '%s' "$ids" | grep -c . || true)"
    if [ "$n" != 1 ]; then
        echo "OPZ_MAC_SIGN_IDENTITY=auto: $n Developer ID Application identities in the keychain, need exactly 1 (set OPZ_MAC_SIGN_IDENTITY, or set it and OPZ_MAC_NOTARY_PROFILE empty for an ad-hoc build)" >&2
        return 1
    fi
    printf '%s\n' "$ids"
}
# notarytool keychain profile, made once with
#   xcrun notarytool store-credentials opz-notary --apple-id <Apple ID> --team-id <TEAMID>
# (looked up in the login keychain, or in OPZ_MAC_NOTARY_KEYCHAIN if set; the
# GitHub Actions release makes a temporary one, .github/ci-keys.sh).
OPZ_MAC_NOTARY_PROFILE="${OPZ_MAC_NOTARY_PROFILE:-opz-notary}"
