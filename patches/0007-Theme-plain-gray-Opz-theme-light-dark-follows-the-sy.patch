Subject: [PATCH] Theme: plain gray Opz theme, light/dark follows the system

---
 browser/themes/BuiltInThemeConfig.sys.mjs |   7 ++
 browser/themes/BuiltInThemes.sys.mjs      |  29 +++++++
 browser/themes/addons/jar.mn              |   4 +
 browser/themes/addons/opz/icon.svg        |   4 +
 browser/themes/addons/opz/manifest.json   | 101 ++++++++++++++++++++++
 browser/themes/addons/opz/preview.svg     |  11 +++
 6 files changed, 156 insertions(+)
 create mode 100644 browser/themes/addons/opz/icon.svg
 create mode 100644 browser/themes/addons/opz/manifest.json
 create mode 100644 browser/themes/addons/opz/preview.svg

diff --git a/browser/themes/BuiltInThemeConfig.sys.mjs b/browser/themes/BuiltInThemeConfig.sys.mjs
index 39d16addcf..5c0dee770d 100644
--- a/browser/themes/BuiltInThemeConfig.sys.mjs
+++ b/browser/themes/BuiltInThemeConfig.sys.mjs
@@ -21,6 +21,13 @@
  *   (-moz-native-theme) media query.
  */
 export const BuiltInThemeConfig = new Map([
+  [
+    "opz-plain@opz",
+    {
+      version: "1.0.0",
+      path: "resource://builtin-themes/opz/",
+    },
+  ],
   [
     "firefox-compact-light@mozilla.org",
     {
diff --git a/browser/themes/BuiltInThemes.sys.mjs b/browser/themes/BuiltInThemes.sys.mjs
index 61343fb1f0..d3dd99e8b6 100644
--- a/browser/themes/BuiltInThemes.sys.mjs
+++ b/browser/themes/BuiltInThemes.sys.mjs
@@ -10,6 +10,10 @@ ChromeUtils.defineESModuleGetters(lazy, {
 });
 
 const kActiveThemePref = "extensions.activeThemeID";
+// Opz: the plain "Opz" theme is switched on once per profile, new or old.
+// After that the user's own choice in Add-ons and themes is kept.
+const kOpzThemeID = "opz-plain@opz";
+const kOpzThemeAppliedPref = "opz.defaultThemeApplied";
 
 class _BuiltInThemes {
   /**
@@ -51,6 +55,31 @@ class _BuiltInThemes {
         activeBuiltInTheme.path
       );
     }
+
+    this.applyOpzThemeOnce();
+  }
+
+  /**
+   * Opz: installs the Opz theme and makes it the active theme, once per
+   * profile (marked by opz.defaultThemeApplied).
+   */
+  async applyOpzThemeOnce() {
+    if (Services.prefs.getBoolPref(kOpzThemeAppliedPref, false)) {
+      return;
+    }
+    try {
+      let { version, path } = this.builtInThemeMap.get(kOpzThemeID);
+      await lazy.AddonManager.maybeInstallBuiltinAddon(
+        kOpzThemeID,
+        version,
+        path
+      );
+      let addon = await lazy.AddonManager.getAddonByID(kOpzThemeID);
+      await addon.enable();
+      Services.prefs.setBoolPref(kOpzThemeAppliedPref, true);
+    } catch (e) {
+      console.error("Opz: could not switch to the Opz theme", e);
+    }
   }
 
   /**
