+++ b/browser/locales/en-US/browser/tabbrowser.ftl
@@ -530,3 +530,6 @@ opz-tab-context-turn-off-auto-collapse =
 opz-toolbar-buttons-on-hover =
     .label = Show buttons only on hover
     .accesskey = h
+opz-webapp-toolbar-on-hover =
+    .label = Show toolbar only on hover
+    .accesskey = t
diff --git a/browser/themes/shared/browser-shared.css b/browser/themes/shared/browser-shared.css
index 368c691115..7339fc16bf 100644
--- a/browser/themes/shared/browser-shared.css
+++ b/browser/themes/shared/browser-shared.css
@@ -1695,3 +1695,35 @@ popupnotificationcontent {
 #syncedTabsOpenSelectedInPrivateWindow {
   display: none !important;
 }
+
+/* Opz: web app and browser windows can hide the toolbar until the pointer reaches the
+ * top edge; it then slides down over the page. It stays while the address
+ * bar is in use or a popup opened from it is showing (opz-toolbar-reveal,
+ * main-popupset.js). */
+:root:is([taskbartab][opz-autohide-toolbar], :not([taskbartab], [popup-window])[opz-autohide-browser-toolbar]):not([inFullscreen]) #navigator-toolbox {
+  position: fixed;
+  left: var(--opz-toolbox-left, 0);
+  right: var(--opz-toolbox-right, 0);
+  /* A strip at the top edge stays under the pointer to bring it back. */
+  /* stylelint-disable-next-line stylelint-plugin-mozilla/use-design-tokens */
+  top: calc(6px - var(--opz-toolbox-height, 40px));
+  z-index: 3;
+  background: inherit;
+  opacity: 0;
+  transition:
+    top 150ms ease,
+    opacity 150ms ease;
+  transition-delay: 400ms;
+
+  &:hover,
+  &:has(#urlbar:is([focused], [open], :focus-within)),
+  :root[opz-toolbar-reveal] & {
+    top: 0;
+    opacity: 1;
+    transition-delay: 100ms;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    transition-property: opacity;
+  }
+}
diff --git a/browser/themes/shared/tabbrowser/content-area.css b/browser/themes/shared/tabbrowser/content-area.css
index 925685df80..6214f22dd7 100644
--- a/browser/themes/shared/tabbrowser/content-area.css
+++ b/browser/themes/shared/tabbrowser/content-area.css
@@ -634,6 +634,11 @@
       margin-inline-end: 0;
     }
 
+    /* With the toolbar hidden (browser-shared.css): the same gap at the top. */
+    :root:is([taskbartab][opz-autohide-toolbar], :not([taskbartab], [popup-window])[opz-autohide-browser-toolbar]):not([inFullscreen]) & {
+      margin-block-start: var(--opz-content-gap);
+    }
+
     @media (-moz-platform: macos) {
       --content-scrollbar-inset-block: var(--border-radius-medium) !important;
       --content-scrollbar-inset-inline-start: var(--border-radius-medium) !important;
