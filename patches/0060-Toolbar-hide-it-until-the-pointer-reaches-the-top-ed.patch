From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Thu, 26 Nov 2026 14:47:46 +0700
Subject: [PATCH] Toolbar: hide it until the pointer reaches the top edge

The toolbar can slide down over the page on hover and hide again when the
pointer leaves, unless the address bar is in use or a popup opened from
the toolbar is showing. The page card then has the same gap at the top as
on the other sides, and the toolbar only covers the content area, never the tab column. A checkbox in the toolbar context menu turns it on or
off: opz.webapp.autoHideToolbar for web app windows (on by default) and
opz.toolbar.autoHide for browser windows (off by default).
---
 browser/base/content/main-popupset.js         | 128 +++++++++++++++++-
 browser/locales/en-US/browser/tabbrowser.ftl  |   3 +
 browser/themes/shared/browser-shared.css      |  32 +++++
 .../themes/shared/tabbrowser/content-area.css |   5 +
 4 files changed, 166 insertions(+), 2 deletions(-)

diff --git a/browser/base/content/main-popupset.js b/browser/base/content/main-popupset.js
index ea31a7ce48..3be5a87d27 100644
--- a/browser/base/content/main-popupset.js
+++ b/browser/base/content/main-popupset.js
@@ -806,8 +806,132 @@ window.addEventListener(
   { once: true }
 );
 
+// Opz: the toolbar can hide until the pointer reaches the top edge (CSS in
+// browser-shared.css), with one pref for web app windows (on by default) and
+// one for browser windows (off by default). Both are mirrored on the root
+// element so the CSS does not depend on when [taskbartab] is set. The toolbar
+// stays out while a popup opened from it is showing, since the pointer then
+// leaves the toolbar.
+const OPZ_AUTOHIDE = [
+  {
+    pref: "opz.webapp.autoHideToolbar",
+    attr: "opz-autohide-toolbar",
+    fallback: true,
+  },
+  {
+    pref: "opz.toolbar.autoHide",
+    attr: "opz-autohide-browser-toolbar",
+    fallback: false,
+  },
+];
+
+function opzAutoHideFor(win) {
+  return OPZ_AUTOHIDE[
+    win.document.documentElement.hasAttribute("taskbartab") ? 0 : 1
+  ];
+}
+
+function opzSyncAutoHide() {
+  for (let { pref, attr, fallback } of OPZ_AUTOHIDE) {
+    document.documentElement.toggleAttribute(
+      attr,
+      Services.prefs.getBoolPref(pref, fallback)
+    );
+  }
+}
+opzSyncAutoHide();
+for (let { pref } of OPZ_AUTOHIDE) {
+  Services.prefs.addObserver(pref, opzSyncAutoHide);
+}
+window.addEventListener(
+  "unload",
+  () => {
+    for (let { pref } of OPZ_AUTOHIDE) {
+      Services.prefs.removeObserver(pref, opzSyncAutoHide);
+    }
+  },
+  { once: true }
+);
+
+// Opz: the hidden toolbar slides down over the content area only, so it
+// never covers the tab column (browser-shared.css reads these offsets).
+window.addEventListener(
+  "load",
+  () => {
+    let tabbox = document.getElementById("tabbrowser-tabbox");
+    let update = () => {
+      let rect = tabbox.getBoundingClientRect();
+      let root = document.documentElement;
+      root.style.setProperty("--opz-toolbox-left", `${rect.left}px`);
+      root.style.setProperty(
+        "--opz-toolbox-right",
+        `${window.innerWidth - rect.right}px`
+      );
+    };
+    new ResizeObserver(update).observe(tabbox);
+    window.addEventListener("resize", update);
+
+    // The toolbar slides with 'top' rather than a transform: a transform
+    // would become the containing block of the idle address bar, which is
+    // fixed to the middle of the window (urlbar.css).
+    let toolbox = document.getElementById("navigator-toolbox");
+    new ResizeObserver(() =>
+      document.documentElement.style.setProperty(
+        "--opz-toolbox-height",
+        `${toolbox.getBoundingClientRect().height}px`
+      )
+    ).observe(toolbox);
+  },
+  { once: true }
+);
+
+const opzToolbarPopups = new Set();
+function opzTrackToolbarPopup(event) {
+  let popup = event.target;
+  if (!popup.matches?.("menupopup, panel")) {
+    return;
+  }
+  if (event.type == "popupshown") {
+    let anchor = popup.anchorNode || popup.triggerNode;
+    if (!anchor?.closest?.("#navigator-toolbox")) {
+      return;
+    }
+    opzToolbarPopups.add(popup);
+  } else {
+    opzToolbarPopups.delete(popup);
+  }
+  document.documentElement.toggleAttribute(
+    "opz-toolbar-reveal",
+    opzToolbarPopups.size > 0
+  );
+}
+window.addEventListener("popupshown", opzTrackToolbarPopup);
+window.addEventListener("popuphidden", opzTrackToolbarPopup);
+
 function opzUpdateToolbarOptions(popup) {
-  let item = popup.querySelector(".opz-toolbar-option");
+  let autoHideItem = popup.querySelector(".opz-webapp-toolbar-option");
+  if (!autoHideItem) {
+    autoHideItem = document.createXULElement("menuitem");
+    autoHideItem.className = "opz-toolbar-option opz-webapp-toolbar-option";
+    autoHideItem.setAttribute("type", "checkbox");
+    document.l10n.setAttributes(autoHideItem, "opz-webapp-toolbar-on-hover");
+    autoHideItem.addEventListener("command", () =>
+      Services.prefs.setBoolPref(
+        opzAutoHideFor(window).pref,
+        autoHideItem.hasAttribute("checked")
+      )
+    );
+    popup.append(autoHideItem);
+  }
+  let { pref, fallback } = opzAutoHideFor(window);
+  autoHideItem.toggleAttribute(
+    "checked",
+    Services.prefs.getBoolPref(pref, fallback)
+  );
+
+  let item = popup.querySelector(
+    ".opz-toolbar-option:not(.opz-webapp-toolbar-option)"
+  );
   if (!item) {
     item = document.createXULElement("menuitem");
     item.className = "opz-toolbar-option";
@@ -820,7 +944,7 @@ function opzUpdateToolbarOptions(popup) {
         !item.hasAttribute("checked")
       )
     );
-    popup.append(item);
+    autoHideItem.before(item);
   }
   item.toggleAttribute(
     "checked",
