diff --git a/browser/themes/shared/browser-shared.css b/browser/themes/shared/browser-shared.css
index 368c691115..2d9f22dd58 100644
--- a/browser/themes/shared/browser-shared.css
+++ b/browser/themes/shared/browser-shared.css
@@ -1695,3 +1695,35 @@ popupnotificationcontent {
 #syncedTabsOpenSelectedInPrivateWindow {
   display: none !important;
 }
+
+/* Opz: web app windows can hide the toolbar until the pointer reaches the
+ * top edge; it then slides down over the page. It stays while the address
+ * bar is in use or a popup opened from it is showing (opz-toolbar-reveal,
+ * main-popupset.js). */
+:root[taskbartab][opz-autohide-toolbar]:not([inFullscreen]) #navigator-toolbox {
+  position: fixed;
+  inset-inline: 0;
+  top: 0;
+  z-index: 3;
+  background: inherit;
+  /* A strip at the top edge stays under the pointer to bring it back. */
+  /* stylelint-disable-next-line stylelint-plugin-mozilla/use-design-tokens */
+  translate: 0 calc(6px - 100%);
+  opacity: 0;
+  transition:
+    translate 150ms ease,
+    opacity 150ms ease;
+  transition-delay: 400ms;
+
+  &:hover,
+  &:has(#urlbar:is([focused], [open], :focus-within)),
+  :root[opz-toolbar-reveal] & {
+    translate: none;
+    opacity: 1;
+    transition-delay: 100ms;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    transition-property: opacity;
+  }
+}
