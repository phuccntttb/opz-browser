   /* Runtime-inserted menu items, exempt from the layout's coverage check. */
@@ -372,9 +511,9 @@ var TabContextMenu = {
      * Reading the pref selects the structure and arms the observer that resets
      * _tabContextMenuArranged when the pref changes.
      */
-    let layout =
-      (this._altTabContextMenu && this.MENU_SECTIONS.altstructure) ||
-      this.MENU_SECTIONS.classic;
+    // Opz: always the Opz layout, with its icon row.
+    let layout = this.MENU_SECTIONS.opz;
+    this._opzEnsureActionsRow(aPopupMenu);
     // MenuSectionLayout throws if the markup and layout disagree and a menuitem is unaccounted for.
     // Catch these exceptions and log them out.
     try {
@@ -389,6 +528,40 @@ var TabContextMenu = {
     this._tabContextMenuArranged = true;
   },
 
+  /*
+   * Opz: the row of icon-only actions at the top of the menu. The items keep
+   * their labels for screen readers; the label is mirrored to the tooltip,
+   * again whenever Fluent drops the tooltip while applying a translation.
+   */
+  _opzEnsureActionsRow(aPopupMenu) {
+    if (document.getElementById("opz_context_tabActions")) {
+      return;
+    }
+    let row = document.createXULElement("menugroup");
+    row.id = "opz_context_tabActions";
+    aPopupMenu.prepend(row);
+    let syncTooltip = item => {
+      let label = item.getAttribute("label");
+      if (label && item.getAttribute("tooltiptext") != label) {
+        item.setAttribute("tooltiptext", label);
+      }
+    };
+    new MutationObserver(records => {
+      for (let { target, addedNodes } of records) {
+        for (let item of [target, ...addedNodes]) {
+          if (item.localName == "menuitem") {
+            item.classList.add("menuitem-iconic");
+            syncTooltip(item);
+          }
+        }
+      }
+    }).observe(row, {
+      childList: true,
+      subtree: true,
+      attributeFilter: ["label", "tooltiptext"],
+    });
+  },
+
   /*
    * Swap in alternate Fluent ids for items that need different wording in the
    * alt layout. We cache the authored id so a pref toggle back to classic can
@@ -1092,6 +1265,9 @@ var TabContextMenu = {
         .setAttribute("data-l10n-id", "tab-context-send-to-device2");
     }
 
+    // Opz: Select All Tabs lives in the Move Tab submenu.
+    document.getElementById("context_selectAllSeparator").hidden = false;
+
     let reopenInContainer = document.getElementById(
       "context_reopenInContainer"
     );
diff --git a/browser/themes/shared/contextmenu.css b/browser/themes/shared/contextmenu.css
index fdf95241bc..7d5aae4a0a 100644
--- a/browser/themes/shared/contextmenu.css
+++ b/browser/themes/shared/contextmenu.css
@@ -57,3 +57,100 @@
 #context-media-eme-learnmore {
   --menuitem-icon: url("chrome://browser/skin/drm-icon.svg");
 }
+
+/* Opz: the tab context menu, with an icon row for the everyday actions. */
+
+#tabContextMenu,
+#tabContextMenu menupopup {
+  --panel-border-radius: 12px;
+  --panel-padding-block: 6px;
+  --menuitem-border-radius: 7px;
+  --menuitem-padding-block: 0.36em;
+  --menuitem-padding-inline: 0.8em;
+
+  menu,
+  menuitem {
+    &:where([_moz-menuactive]:not([disabled])) {
+      color: inherit;
+      background-color: color-mix(in srgb, currentColor 11%, transparent);
+    }
+  }
+
+  menuseparator {
+    padding-block: 5px;
+    padding-inline: 0.8em;
+  }
+}
+
+#tabContextMenu {
+  min-width: 15em;
+
+  /* An action that can't be used now only takes room. */
+  > :is(menu, menuitem)[disabled] {
+    display: none;
+  }
+
+  #context_closeTab[_moz-menuactive] {
+    color: light-dark(#c8102e, #ff8589);
+    background-color: color-mix(in srgb, currentColor 13%, transparent);
+  }
+}
+
+#opz_context_tabActions {
+  gap: 2px;
+
+  > .menuitem-iconic {
+    flex: 1;
+    justify-content: center;
+    align-items: center;
+    margin: 0;
+    padding: 0;
+
+    > .menu-text,
+    > .menu-accel {
+      display: none;
+    }
+
+    > .menu-icon {
+      width: auto;
+      height: auto;
+      padding: 8px;
+      margin: 0;
+    }
+  }
+}
+
+#context_reloadTab,
+#context_reloadSelectedTabs {
+  --menuitem-icon: url("chrome://global/skin/icons/reload.svg");
+}
+
+#context_toggleMuteTab,
+#context_toggleMuteSelectedTabs {
+  --menuitem-icon: url("chrome://global/skin/media/audio-muted.svg");
+  &[muted] {
+    --menuitem-icon: url("chrome://global/skin/media/audio.svg");
+  }
+}
+
+#context_pinTab,
+#context_unpinTab,
+#context_pinSelectedTabs,
+#context_unpinSelectedTabs {
+  --menuitem-icon: url("chrome://browser/skin/pin.svg");
+}
+
+#context_unpinTab,
+#context_unpinSelectedTabs {
+  color: AccentColor;
+}
+
+#context_duplicateTab,
+#context_duplicateTabs {
+  --menuitem-icon: url("chrome://global/skin/icons/edit-copy.svg");
+}
+
+#context_bookmarkTab,
+#context_bookmarkSelectedTabs {
+  --menuitem-icon: url("chrome://browser/skin/bookmark-hollow.svg");
+}
