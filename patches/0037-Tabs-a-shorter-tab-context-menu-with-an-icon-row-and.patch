From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Thu, 19 Nov 2026 16:14:23 +0700
Subject: [PATCH] Tabs: a shorter tab context menu with an icon row and rounded
 style

The everyday actions (reload, mute, pin, duplicate, bookmark) are a row
of icons at the top. Select All Tabs moves into the Move Tab submenu and
Close Duplicate Tabs into Close Multiple Tabs. Actions that can't be used
now are hidden instead of greyed out. The menu and its submenus get
rounded corners, roomier items and a soft hover highlight.

Right-clicking the empty part of the vertical tab column opens the menu
for the selected tab.
---
 browser/components/sidebar/sidebar-main.mjs   |  29 +++
 .../tabbrowser/content/tab-context-menu.js    | 182 +++++++++++++++++-
 browser/themes/shared/contextmenu.css         |  97 ++++++++++
 3 files changed, 305 insertions(+), 3 deletions(-)

diff --git a/browser/components/sidebar/sidebar-main.mjs b/browser/components/sidebar/sidebar-main.mjs
index 6b06774b58..e217d23601 100644
--- a/browser/components/sidebar/sidebar-main.mjs
+++ b/browser/components/sidebar/sidebar-main.mjs
@@ -331,6 +331,31 @@ export default class SidebarMain extends MozLitElement {
     }
   }
 
+  opzOpenTabMenuOnEmptyArea(event) {
+    if (
+      !window.SidebarController.sidebarVerticalTabsEnabled ||
+      event.defaultPrevented
+    ) {
+      return false;
+    }
+    let onControl = event
+      .composedPath()
+      .some(node =>
+        node.matches?.(
+          "tab, tab-group, button, toolbarbutton, moz-button, input, a[href]"
+        )
+      );
+    if (onControl) {
+      return false;
+    }
+    event.preventDefault();
+    window.gBrowser.translateTabContextMenu();
+    document
+      .getElementById("tabContextMenu")
+      .openPopupAtScreen(event.screenX, event.screenY, true, event);
+    return true;
+  }
+
   async onSidebarPopupShowing(event) {
     // Store the context menu target which holds the id required for managing sidebar items
     let targetHost = event.explicitOriginalTarget.getRootNode().host;
@@ -595,6 +620,10 @@ export default class SidebarMain extends MozLitElement {
         }
         break;
       case "contextmenu":
+        // Opz: the empty part of the tab column opens the selected tab's menu.
+        if (this.opzOpenTabMenuOnEmptyArea(e)) {
+          break;
+        }
         if (
           !["tabs-newtab-button", "vertical-tabs-newtab-button"].includes(
             e.target.id
