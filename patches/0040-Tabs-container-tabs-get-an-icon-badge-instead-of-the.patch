From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Thu, 19 Nov 2026 17:27:15 +0700
Subject: [PATCH] Tabs: container tabs get an icon badge instead of the stroke
 across the tab

---
 browser/themes/shared/tabbrowser/tabs.css | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/browser/themes/shared/tabbrowser/tabs.css b/browser/themes/shared/tabbrowser/tabs.css
index 3c8851bbe2..26adccd28e 100644
--- a/browser/themes/shared/tabbrowser/tabs.css
+++ b/browser/themes/shared/tabbrowser/tabs.css
@@ -3606,3 +3606,26 @@ toolbar:not(#TabsToolbar) #firefox-view-button {
     pointer-events: none;
   }
 }
+
+/* Opz: container tabs get a badge with the container's icon and color on
+   the tab icon, like private tabs, instead of the stroke across the tab. */
+.tabbrowser-tab[usercontextid]:not([opz-private]) {
+  > .tab-stack > .tab-background > .tab-context-line {
+    display: none;
+  }
+
+  .tab-icon-stack::after {
+    content: "";
+    position: absolute;
+    inset-block-end: -4px;
+    inset-inline-end: -4px;
+    width: 11px;
+    height: 11px;
+    border-radius: 50%;
+    background: var(--identity-icon) center / 7px no-repeat var(--identity-icon-color);
+    -moz-context-properties: fill;
+    fill: #fff;
+    z-index: 1;
+    pointer-events: none;
+  }
+}
