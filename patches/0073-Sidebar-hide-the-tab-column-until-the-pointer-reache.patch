diff --git a/browser/themes/shared/sidebar.css b/browser/themes/shared/sidebar.css
index 15877cb7ea..7c23af0dc4 100644
--- a/browser/themes/shared/sidebar.css
+++ b/browser/themes/shared/sidebar.css
@@ -600,3 +600,90 @@ sidebar-main,
     background-color: var(--toolbox-background-color-inactive);
   }
 }
+
+/* Opz: the vertical tab column can hide until the pointer reaches the window
+ * edge it sits on (opz.sidebar.autoHide, mirrored as opz-autohide-sidebar by
+ * main-popupset.js). It then slides out over the page and hides again once
+ * the pointer leaves it, unless a popup opened from it is showing
+ * (opz-sidebar-reveal). The page takes the whole width meanwhile. It slides
+ * with inset-inline-start rather than translate, which the column's own
+ * expand/collapse animation uses (browser-sidebar.js). */
+@media -moz-pref("sidebar.verticalTabs") {
+  :root[opz-autohide-sidebar]:not([taskbartab], [popup-window], [inFullscreen]) {
+    #sidebar-container {
+      position: absolute !important;
+      inset-block: 0 !important;
+      /* A strip at the window edge stays under the pointer to bring it back. */
+      /* stylelint-disable-next-line stylelint-plugin-mozilla/use-design-tokens */
+      inset-inline-start: calc(6px - var(--opz-sidebar-width, 300px)) !important;
+      inset-inline-end: auto !important;
+      z-index: var(--browser-area-z-index-sidebar-expand-on-hover) !important;
+      color: var(--toolbox-text-color);
+      background-image: var(--toolbox-background-gradient), image(var(--toolbox-background-color));
+      background-size:
+        100vw 100vh,
+        auto;
+      background-color: light-dark(#e8e8e8, #202020);
+      border-inline-end: 0.01px solid var(--sidebar-border-color);
+      opacity: 0;
+      transition:
+        inset-inline-start 150ms ease,
+        opacity 150ms ease;
+      transition-delay: 400ms;
+
+      &[sidebar-positionend] {
+        inset-inline-start: auto !important;
+        /* stylelint-disable-next-line stylelint-plugin-mozilla/use-design-tokens */
+        inset-inline-end: calc(6px - var(--opz-sidebar-width, 300px)) !important;
+        border-inline-end: none;
+        border-inline-start: 0.01px solid var(--sidebar-border-color);
+        background-position-x: 100%;
+        transition-property: inset-inline-end, opacity;
+      }
+
+      &:hover,
+      :root[opz-sidebar-reveal] & {
+        inset-inline-start: 0 !important;
+        opacity: 1;
+        transition-delay: 100ms;
+
+        &[sidebar-positionend] {
+          inset-inline-start: auto !important;
+          inset-inline-end: 0 !important;
+        }
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        transition-property: opacity;
+      }
+    }
+
+    /* A theme that paints the whole window (see above): the column sits at
+     * the window edge when it shows, whatever its offset while hidden. */
+    &[lwtheme]:not([theme-image-in-toolbox], [lwtheme-image]) #sidebar-container {
+      background-image: var(--toolbox-background-image);
+      background-repeat: no-repeat;
+      background-size: 100vw 100vh;
+      background-position: 0 var(--opz-sidebar-bg-y, 0);
+      background-color: var(--toolbox-background-color);
+
+      &[sidebar-positionend] {
+        background-position-x: 100%;
+      }
+
+      &:-moz-window-inactive {
+        background-color: var(--toolbox-background-color-inactive);
+      }
+    }
+
+    /* The column takes no room, so nothing makes room for it. */
+    #sidebar-launcher-splitter {
+      display: none !important;
+    }
+
+    #tabbrowser-tabbox,
+    #sidebar-box {
+      margin-inline: 0 !important;
+    }
+  }
+}
