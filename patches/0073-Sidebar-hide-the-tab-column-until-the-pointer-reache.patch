+// Opz: the vertical tab column can hide until the pointer reaches the window
+// edge (CSS at the end of sidebar.css).
+const OPZ_AUTOHIDE_SIDEBAR_PREF = "opz.sidebar.autoHide";
+function opzSyncAutoHideSidebar() {
+  document.documentElement.toggleAttribute(
+    "opz-autohide-sidebar",
+    Services.prefs.getBoolPref(OPZ_AUTOHIDE_SIDEBAR_PREF, false)
+  );
+}
+opzSyncAutoHideSidebar();
+Services.prefs.addObserver(OPZ_AUTOHIDE_SIDEBAR_PREF, opzSyncAutoHideSidebar);
+window.addEventListener(
+  "unload",
+  () =>
+    Services.prefs.removeObserver(
+      OPZ_AUTOHIDE_SIDEBAR_PREF,
+      opzSyncAutoHideSidebar
+    ),
+  { once: true }
+);
+
