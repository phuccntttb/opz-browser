 .../tabbrowser/content/tab-context-menu.js    | 25 +++++-
 browser/locales/en-US/browser/tabbrowser.ftl  |  3 +
 browser/themes/shared/sidebar.css             | 87 +++++++++++++++++++
 .../themes/shared/tabbrowser/content-area.css |  7 ++
 5 files changed, 186 insertions(+), 6 deletions(-)

