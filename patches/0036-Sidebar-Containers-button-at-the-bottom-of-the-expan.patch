+
+#opz-containers-panel {
+  --arrowpanel-padding: 0;
+}
+
+.opz-containers-body {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-medium);
+  box-sizing: border-box;
+  width: 24em;
+  max-height: 80vh;
+  padding: var(--space-large);
+  overflow-y: auto;
+
+  > moz-button:not([type="primary"]) {
+    align-self: flex-start;
+  }
+
+  > div > .container-editor {
+    padding: 0;
+  }
+
+  > .panel-footer {
+    margin: 0;
+    padding: 0;
+  }
+}
+
+.opz-containers-title {
+  margin: 0;
+  font-size: var(--font-size-large);
+  font-weight: var(--font-weight-bold);
+}
+
+.opz-containers-body .containers-identity-item {
+  --box-icon-start-fill: var(--identity-icon-color);
+  --box-icon-size: var(--icon-size-xlarge);
+
+  @media -moz-pref("browser.nova.enabled") {
+    --box-icon-start-fill: var(--identity-fill-color);
+    --box-icon-padding: round(up, var(--space-small), 0.5px);
+    --box-icon-border-radius: var(--border-radius-circle);
+    --box-icon-background: var(--identity-fill-tint);
+  }
+}
+
+.opz-containers-body .container-editor .swatches::part(inputs) {
+  justify-content: flex-start;
+}
