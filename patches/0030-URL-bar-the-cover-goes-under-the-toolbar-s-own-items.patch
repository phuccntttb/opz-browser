From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Fri, 13 Nov 2026 13:56:31 +0700
Subject: [PATCH] URL bar: the cover goes under the toolbar's own items, so the
 card's icons get the clicks

---
 browser/themes/shared/urlbar.css | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/browser/themes/shared/urlbar.css b/browser/themes/shared/urlbar.css
index bbaa98972f..6a81bfb158 100644
--- a/browser/themes/shared/urlbar.css
+++ b/browser/themes/shared/urlbar.css
@@ -1783,7 +1783,7 @@ toolbar[inactive="true"] .urlbar,
   display: block;
   position: fixed;
   inset: 0;
-  z-index: 0;
+  z-index: -1;
   -moz-window-dragging: no-drag;
 }
 
