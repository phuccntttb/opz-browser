From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Thu, 12 Nov 2026 18:48:16 +0700
Subject: [PATCH] URL bar: a transparent cover over the window while it is
 open, so clicks outside only close it

---
 browser/base/content/browser-init.js |  6 ++++++
 browser/themes/shared/urlbar.css     | 12 ++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/browser/base/content/browser-init.js b/browser/base/content/browser-init.js
index 7be32578e9..599e5d3708 100644
--- a/browser/base/content/browser-init.js
+++ b/browser/base/content/browser-init.js
@@ -408,6 +408,12 @@ var gBrowserInit = {
     });
     gBrowser.addTabsProgressListener(FullPageTranslationsPanel);
 
+    // Opz: while the address bar is open this covers the window (see
+    // urlbar.css), so a click outside only closes it and reaches nothing.
+    let urlbarScrim = document.createXULElement("box");
+    urlbarScrim.id = "opz-urlbar-scrim";
+    document.getElementById("navigator-toolbox").append(urlbarScrim);
+
     // Opz: a click anywhere outside the address bar closes it, also on parts
     // of the window that do not take focus (the tab column, empty toolbar).
     window.addEventListener(
diff --git a/browser/themes/shared/urlbar.css b/browser/themes/shared/urlbar.css
index 172202a397..7c35e3d2f6 100644
--- a/browser/themes/shared/urlbar.css
+++ b/browser/themes/shared/urlbar.css
@@ -1774,3 +1774,15 @@ toolbar[inactive="true"] .urlbar,
     }
   }
 }
+
+#opz-urlbar-scrim {
+  display: none;
+}
+
+:root:not([customizing]) #navigator-toolbox:has(#urlbar:is([focused], [open], [popover-open], [usertyping], [searchmode])) > #opz-urlbar-scrim {
+  display: block;
+  position: fixed;
+  inset: 0;
+  z-index: 0;
+  -moz-window-dragging: no-drag;
+}
