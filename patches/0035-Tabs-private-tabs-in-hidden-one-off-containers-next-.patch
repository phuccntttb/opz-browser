+    // Without the card openTab has opened a plain tab, not a private one.
+    if (!gURLBar.opzOpenInNewTab) {
+      release();
+    }
+  },
+
+  /**
+   * openLinkIn params for a load: a pick from the card of "New private tab"
+   * goes to its hidden container.
+   */
+  adjustLinkParams(window, where, params) {
+    let id = window?.gURLBar?.opzPrivateUserContextId;
+    // A "current" load with another container opens a new tab instead.
+    if (!id || where == "save") {
+      return params;
+    }
+    return { ...params, userContextId: id };
+  },
+
+  // Menus
+
+  /**
+   * The New Tab button's popup: "New private tab" right under "New Tab".
+   */
+  addNewTabMenuItem(window, popup) {
+    let { document } = window;
+    let item = document.createXULElement("menuitem");
+    item.className = "opz-new-private-tab";
+    document.l10n.setAttributes(item, "opz-private-tab-new");
+    item.addEventListener("command", event => {
+      // Not the button's own command.
+      event.stopPropagation();
+      this.openNewPrivateTab(window);
+    });
+    let newTabItem = popup.querySelector(':scope > [data-usercontextid="0"]');
+    if (newTabItem) {
+      newTabItem.after(item);
+    } else {
+      popup.prepend(item);
+    }
+  },
+
+  /**
+   * The tab context menu: "New private tab", and "New private tab in this
+   * session" for a private tab.
+   */
+  updateTabContextMenu(window, contextTab) {
+    let { document } = window;
+    if (!document.getElementById("opz_context_newPrivateTab")) {
+      let newItem = document.createXULElement("menuitem");
+      newItem.id = "opz_context_newPrivateTab";
+      document.l10n.setAttributes(newItem, "opz-private-tab-new");
+      newItem.addEventListener("command", () => this.openNewPrivateTab(window));
+      document.getElementById("context_openANewTab").after(newItem);
+    }
+    let item = document.getElementById("opz_context_newPrivateTabInSession");
+    if (!item) {
+      item = document.createXULElement("menuitem");
+      item.id = "opz_context_newPrivateTabInSession";
+      document.l10n.setAttributes(item, "opz-private-tab-new-in-session");
+      item.addEventListener("command", () => {
+        let tab = window.TabContextMenu.contextTab;
+        if (this.isPrivateTab(tab)) {
+          this.openNewPrivateTab(window, tab.userContextId);
+        }
+      });
+      document.getElementById("opz_context_newPrivateTab").after(item);
+    }
+    item.hidden = !this.isPrivateTab(contextTab);
+  },
+
+  // Session store
+
+  /**
+   * Drops private tabs from a session state about to be written or kept as
+   * the last session. Windows and tab lists are copied, not changed in place,
+   * since they are the live session store data.
+   */
+  filterSessionState(state) {
+    let isPrivateState = tabState =>
+      this.isPrivateUserContextId(tabState?.userContextId || 0);
+    let filterWindow = win => {
+      let copy = { ...win };
+      if (Array.isArray(win.tabs) && win.tabs.some(isPrivateState)) {
+        let selectedIndex = (win.selected || 1) - 1;
+        copy.tabs = win.tabs.filter(tab => !isPrivateState(tab));
+        let before = win.tabs
+          .slice(0, selectedIndex)
+          .filter(tab => !isPrivateState(tab)).length;
+        let selected = isPrivateState(win.tabs[selectedIndex])
+          ? before
+          : before + 1;
+        copy.selected = Math.max(1, Math.min(selected, copy.tabs.length));
+      }
+      if (Array.isArray(win._closedTabs)) {
+        copy._closedTabs = win._closedTabs.filter(
+          t => !isPrivateState(t.state)
+        );
+      }
+      return copy;
+    };
+    if (Array.isArray(state.windows)) {
+      state.windows = state.windows.map(filterWindow);
+    }
+    if (Array.isArray(state._closedWindows)) {
+      state._closedWindows = state._closedWindows
+        .map(filterWindow)
+        .filter(win => win.tabs?.length);
+    }
+    if (Array.isArray(state.cookies)) {
+      state.cookies = state.cookies.filter(
+        c =>
+          !this.isPrivateUserContextId(c.originAttributes?.userContextId || 0)
+      );
+    }
+    return state;
+  },
+
+  /**
+   * A closed window is kept for "reopen closed window" without its private
+   * tabs.
+   */
+  stripClosedWindow(winData) {
+    if (
+      !winData.tabs?.some(t =>
+        this.isPrivateUserContextId(t.userContextId || 0)
+      )
+    ) {
+      return;
+    }
+    let { tabs, selected } = this.filterSessionState({ windows: [winData] })
+      .windows[0];
+    winData.tabs = tabs;
+    winData.selected = selected;
+  },
+};
