diff --git a/browser/modules/OpzPrivateTabs.sys.mjs b/browser/modules/OpzPrivateTabs.sys.mjs
new file mode 100644
index 0000000000..b110db53a9
--- /dev/null
+++ b/browser/modules/OpzPrivateTabs.sys.mjs
@@ -0,0 +1,523 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Opz private tabs: tabs that sit next to normal tabs in an ordinary window
+ * but keep nothing. Each one lives in a hidden, one-off container (a
+ * userContextId from a range that ContextualIdentityService never hands out
+ * and that has no identity), so its cookies and storage are its own. Tabs
+ * opened from it inherit its container; "New private tab in this session"
+ * opens another tab in the same one. When the last tab of a hidden container
+ * is gone its data is wiped. Private tabs record no history, are not kept by
+ * session restore or "recently closed", are not synced, and leave no search,
+ * form or download history.
+ *
+ * Ids that may hold data are listed in a small file in the profile, so that
+ * what a crash leaves behind is wiped at the next start, and an id is not used
+ * again before it has been wiped.
+ */
+
+import { clearTimeout, setTimeout } from "resource://gre/modules/Timer.sys.mjs";
+
+// Far above anything ContextualIdentityService allocates (it counts up from
+// the default containers) and below its reserved UINT32_MAX.
+const FIRST_ID = 0x70000000;
+const LAST_ID = 0x7ffffffe;
+const PALETTE_SIZE = 6;
+// How long a closed container waits before its data goes, so the pages of its
+// last tab are gone first.
+const WIPE_DELAY_MS = 2000;
+const STATE_FILE = "opz-private-tabs.json";
+
+let gState = null; // { lastId, pending: Set }
+let gInitPromise = null;
+let gWriteQueue = Promise.resolve();
+let gCheckTimer = null;
+const gWiping = new Set();
+const gAllocating = new Set();
+
+function statePath() {
+  return PathUtils.join(PathUtils.profileDir, STATE_FILE);
+}
+
+function saveState() {
+  let data = { lastId: gState.lastId, pending: [...gState.pending] };
+  gWriteQueue = gWriteQueue
+    .then(() =>
+      IOUtils.writeJSON(statePath(), data, { tmpPath: statePath() + ".tmp" })
+    )
+    .catch(console.error);
+  return gWriteQueue;
+}
+
+function wipe(userContextId) {
+  if (gWiping.has(userContextId)) {
+    return;
+  }
+  gWiping.add(userContextId);
+  Services.clearData.deleteDataFromOriginAttributesPattern(
+    { userContextId },
+    {
+      onDataDeleted() {
+        gWiping.delete(userContextId);
+        // A tab may have come back to it while it was being wiped.
+        if (!OpzPrivateTabs.idsInUse().has(userContextId)) {
+          gState.pending.delete(userContextId);
+          saveState();
+        }
+      },
+    }
+  );
+}
+
+export const OpzPrivateTabs = {
+  FIRST_ID,
+  LAST_ID,
+
+  /**
+   * The one test for "is this a private tab's container".
+   *
+   * @param {number|string} userContextId
+   */
+  isPrivateUserContextId(userContextId) {
+    let id = Number(userContextId);
+    return id >= FIRST_ID && id <= LAST_ID;
+  },
+
+  isPrivateBrowser(browser) {
+    return this.isPrivateUserContextId(
+      browser?.getAttribute?.("usercontextid") || 0
+    );
+  },
+
+  isPrivateTab(tab) {
+    return this.isPrivateUserContextId(tab?.userContextId || 0);
+  },
+
+  /**
+   * Whether the address bar of this window is opening its pick in a private
+   * tab, or is used in one: then what it picks is not remembered either.
+   *
+   * @param {Window} window
+   * @param {MozBrowser} [browser] the browser the load goes to, if known.
+   */
+  isPrivateUrlbarLoad(window, browser = null) {
+    if (window?.gURLBar?.opzPrivateUserContextId) {
+      return true;
+    }
+    if (browser) {
+      return this.isPrivateBrowser(browser);
+    }
+    let selected = window?.gBrowser?.selectedBrowser;
+    return !window?.gURLBar?.opzOpenInNewTab && this.isPrivateBrowser(selected);
+  },
+
+  /**
+   * Startup: wipe whatever an earlier run left behind.
+   */
+  init() {
+    if (!gInitPromise) {
+      gState = { lastId: FIRST_ID - 1, pending: new Set() };
+      gInitPromise = (async () => {
+        try {
+          let data = await IOUtils.readJSON(statePath());
+          if (this.isPrivateUserContextId(data.lastId)) {
+            gState.lastId = data.lastId;
+          }
+          for (let id of data.pending || []) {
+            if (this.isPrivateUserContextId(id)) {
+              gState.pending.add(id);
+            }
+          }
+        } catch (ex) {
+          if (!DOMException.isInstance(ex) || ex.name != "NotFoundError") {
+            console.error(ex);
+          }
+        }
+        this.scheduleCheck(0);
+      })();
+    }
+    return gInitPromise;
+  },
+
+  /**
+   * A container id for a new private session, one that holds no data.
+   */
+  async allocate() {
+    await this.init();
+    let inUse = this.idsInUse();
+    let id = gState.lastId;
+    do {
+      id = id >= LAST_ID ? FIRST_ID : id + 1;
+    } while (gState.pending.has(id) || gWiping.has(id) || inUse.has(id));
+    gState.lastId = id;
+    // On disk before the id is used, and cleared of anything a crash before
+    // that point could have left in it.
+    gState.pending.add(id);
+    gAllocating.add(id);
+    try {
+      await saveState();
+      await new Promise(resolve =>
+        Services.clearData.deleteDataFromOriginAttributesPattern(
+          { userContextId: id },
+          { onDataDeleted: resolve }
+        )
+      );
+    } finally {
+      gAllocating.delete(id);
+    }
+    return id;
+  },
+
+  /**
+   * Called for every new <browser>, before it is inserted.
+   */
+  onBrowserCreated(browser, userContextId) {
+    if (!this.isPrivateUserContextId(userContextId)) {
+      return;
+    }
+    // Checked by the docshell before a visit or title is stored.
+    browser.setAttribute("disableglobalhistory", "true");
+    this.init();
+    if (!gState.pending.has(userContextId)) {
+      gState.pending.add(userContextId);
+      saveState();
+    }
+  },
+
+  idsInUse() {
+    let ids = new Set(gAllocating);
+    for (let win of Services.wm.getEnumerator("navigator:browser")) {
+      if (win.closed || !win.gBrowser) {
+        continue;
+      }
+      for (let tab of win.gBrowser.tabs) {
+        if (!tab.closing && this.isPrivateTab(tab)) {
+          ids.add(tab.userContextId);
+        }
+      }
+      let cardId = win.gURLBar?.opzPrivateUserContextId;
+      if (cardId) {
+        ids.add(cardId);
+      }
+    }
+    return ids;
+  },
+
+  scheduleCheck(delay = WIPE_DELAY_MS) {
+    if (gCheckTimer) {
+      clearTimeout(gCheckTimer);
+    }
+    gCheckTimer = setTimeout(() => {
+      gCheckTimer = null;
+      this.wipeUnused();
+    }, delay);
+  },
+
+  wipeUnused() {
+    if (!gState) {
+      return;
+    }
+    let inUse = this.idsInUse();
+    for (let id of gState.pending) {
+      if (!inUse.has(id)) {
+        wipe(id);
+      }
+    }
+  },
+
+  // Windows
+
+  initWindow(window) {
+    this.init();
+    let { gBrowser, document } = window;
+    document.l10n?.addResourceIds(["browser/opzPrivateTabs.ftl"]);
+    for (let tab of gBrowser.tabs) {
+      this.markTab(tab);
+    }
+    let moved = new Set();
+    let regroupLater = tab => {
+      if (this.regrouping) {
+        return;
+      }
+      if (!moved.size) {
+        window.setTimeout(() => {
+          let tabs = [...moved];
+          moved.clear();
+          this.regrouping = true;
+          try {
+            for (let t of tabs) {
+              if (!t.closing && t.isConnected) {
+                this.regroup(gBrowser, t);
+              }
+            }
+          } finally {
+            this.regrouping = false;
+          }
+        });
+      }
+      moved.add(tab);
+    };
+    gBrowser.tabContainer.addEventListener("TabOpen", e => {
+      this.markTab(e.target);
+      this.keepSessionTogether(gBrowser, e.target);
+      regroupLater(e.target);
+    });
+    gBrowser.tabContainer.addEventListener("TabMove", e =>
+      regroupLater(e.target)
+    );
+    gBrowser.tabContainer.addEventListener("TabClose", e => {
+      // A tab moved to another window is not gone.
+      if (!e.detail?.adoptedBy && this.isPrivateTab(e.target)) {
+        this.scheduleCheck();
+      }
+    });
+    window.addEventListener("unload", () => this.scheduleCheck(), {
+      once: true,
+    });
+  },
+
+  markTab(tab) {
+    if (!this.isPrivateTab(tab)) {
+      return;
+    }
+    let index = (tab.userContextId - FIRST_ID) % PALETTE_SIZE;
+    tab.setAttribute("opz-private", index);
+  },
+
+  /**
+   * A new tab of a private session goes next to the session's other tabs.
+   */
+  keepSessionTogether(gBrowser, tab) {
+    if (!this.isPrivateTab(tab) || tab.pinned) {
+      return;
+    }
+    let others = gBrowser.tabs.filter(
+      t =>
+        t != tab &&
+        !t.closing &&
+        !t.pinned &&
+        t.userContextId == tab.userContextId
+    );
+    if (!others.length) {
+      return;
+    }
+    let indexes = [...others, tab].map(t => t.index).sort((a, b) => a - b);
+    if (indexes.at(-1) - indexes[0] == indexes.length - 1) {
+      return;
+    }
+    gBrowser.moveTabAfter(tab, others.at(-1));
+  },
+
+  sessionTabs(gBrowser, userContextId) {
+    return gBrowser.tabs.filter(
+      t => !t.pinned && !t.closing && t.userContextId == userContextId
+    );
+  },
+
+  /**
+   * Keeps the tabs of each private session next to each other after `tab`
+   * moved: a tab dropped inside a session is put after it, and the rest of a
+   * moved private tab's session follows it.
+   */
+  regroup(gBrowser, tab) {
+    if (tab.pinned) {
+      return;
+    }
+    let tabs = gBrowser.tabs.filter(t => !t.pinned && !t.closing);
+    let i = tabs.indexOf(tab);
+    let [prev, next] = [tabs[i - 1], tabs[i + 1]];
+    if (
+      prev &&
+      next &&
+      this.isPrivateTab(prev) &&
+      prev.userContextId == next.userContextId &&
+      tab.userContextId != prev.userContextId
+    ) {
+      gBrowser.moveTabAfter(
+        tab,
+        this.sessionTabs(gBrowser, prev.userContextId).at(-1)
+      );
+    }
+    if (!this.isPrivateTab(tab)) {
+      return;
+    }
+    let session = this.sessionTabs(gBrowser, tab.userContextId);
+    let indexes = session.map(t => t.index);
+    if (indexes.at(-1) - indexes[0] == session.length - 1) {
+      return;
+    }
+    let at = session.indexOf(tab);
+    let anchor = tab;
+    for (let t of session.slice(at + 1)) {
+      gBrowser.moveTabAfter(t, anchor);
+      anchor = t;
+    }
+    anchor = tab;
+    for (let t of session.slice(0, at).reverse()) {
+      gBrowser.moveTabBefore(t, anchor);
+      anchor = t;
+    }
+  },
+
+  /**
+   * Opz's New Tab in a hidden container: the address bar card opens over the
+   * current tab and what is picked opens in a new private tab.
+   *
+   * @param {Window} window
+   * @param {number} [userContextId] an existing private container to share.
+   */
+  async openNewPrivateTab(window, userContextId = null) {
+    let id = this.isPrivateUserContextId(userContextId)
+      ? Number(userContextId)
+      : await this.allocate();
+    let { gURLBar } = window;
+    let release = () => {
+      gURLBar.opzPrivateUserContextId = null;
+      // An id nothing ended up using is dropped again.
+      this.scheduleCheck();
+    };
+    gURLBar.opzPrivateUserContextId = id;
+    gURLBar.inputField.addEventListener(
+      "blur",
+      () => window.setTimeout(release, 0),
+      { once: true }
+    );
