+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  BookmarkHTMLUtils: "resource://gre/modules/BookmarkHTMLUtils.sys.mjs",
+  PlacesUIUtils: "moz-src:///browser/components/places/PlacesUIUtils.sys.mjs",
+  PlacesUtils: "resource://gre/modules/PlacesUtils.sys.mjs",
+});
+
+const PANEL_ID = "opz-bookmarks-panel";
+const PAGE = "chrome://browser/content/places/bookmarksSidebar.xhtml";
+
+/**
+ * Opz: the bookmarks sidebar page (search box and bookmark tree) in a panel
+ * anchored to the Bookmarks button at the bottom of the vertical tab column.
+ */
+export class OpzBookmarksPanel {
+  /**
+   * @param {Window} win
+   * @param {Element} button
+   *   The panel opens at its end edge, bottoms aligned, and the button gets
+   *   aria-expanded while it is open.
+   */
+  static toggle(win, button) {
+    let panel = win.document.getElementById(PANEL_ID);
+    if (panel && (panel.state == "open" || panel.state == "showing")) {
+      panel.hidePopup();
+      return;
+    }
+    win.opzBookmarksPanel ??= new OpzBookmarksPanel(win);
+    win.opzBookmarksPanel.open(button);
+  }
+
+  constructor(win) {
+    this.win = win;
+    let doc = win.document;
+
+    this.panel = doc.createXULElement("panel");
+    this.panel.id = PANEL_ID;
+    this.panel.className = "panel-no-padding";
+    this.panel.setAttribute("type", "arrow");
+    this.panel.setAttribute("orient", "vertical");
+    this.panel.setAttribute("role", "dialog");
+    this.panel.style.setProperty("--arrowpanel-padding", "0");
+
+    this.browser = doc.createXULElement("browser");
+    this.browser.setAttribute("disablehistory", "true");
+    this.browser.setAttribute("disablefullscreen", "true");
+    this.browser.setAttribute("autoscroll", "false");
+    this.browser.setAttribute("tooltip", "aHTMLTooltip");
+    this.browser.style.width = "22em";
+    this.browser.style.height = "min(56em, 85vh)";
+    this.browser.setAttribute("src", PAGE);
+    this.panel.append(this.browser);
+    doc.getElementById("mainPopupSet").append(this.panel);
+
+    this.browser.addEventListener(
+      "load",
+      e => {
+        if (e.target.documentURI == PAGE) {
+          this.onPageLoad(e.target);
+        }
+      },
+      true
+    );
+
+    this.panel.addEventListener("popupshown", e => {
+      if (e.target == this.panel) {
+        this.browser.contentDocument?.getElementById("search-box")?.focus();
+      }
+    });
+    this.panel.addEventListener("popuphidden", e => {
+      if (e.target == this.panel) {
+        this.button?.removeAttribute("aria-expanded");
+      }
+    });
+  }
+
+  onPageLoad(pageDoc) {
+    pageDoc.getElementById("sidebar-panel-header").hidden = true;
+    let searchContainer = pageDoc.getElementById("sidebar-search-container");
+    let button = (iconsrc, l10nId, onClick) => {
+      let el = pageDoc.createElementNS(
+        "http://www.w3.org/1999/xhtml",
+        "moz-button"
+      );
+      el.setAttribute("type", "icon ghost");
+      el.setAttribute("iconsrc", iconsrc);
+      el.style.marginInlineStart = "var(--space-xxsmall)";
+      pageDoc.l10n.formatMessages([l10nId]).then(([msg]) => {
+        let label = msg?.attributes?.find(a => a.name == "label")?.value;
+        el.title = label;
+        el.ariaLabel = label;
+      });
+      el.addEventListener("click", () => {
+        this.panel.hidePopup();
+        onClick();
+      });
+      return el;
+    };
+    searchContainer.append(
+      button(
+        "chrome://browser/skin/import.svg",
+        "places-import-bookmarks-from-html",
+        () => this.importFromHTML()
+      ),
+      button(
+        "chrome://browser/skin/library.svg",
+        "places-manage-bookmarks",
+        () => this.win.PlacesCommandHook.showPlacesOrganizer("BookmarksToolbar")
+      )
+    );
+
+    let tree = pageDoc.getElementById("bookmarks-view");
+    let toolbarGuid = lazy.PlacesUtils.bookmarks.toolbarGuid;
+    let toolbarPlace = `place:parent=${toolbarGuid}`;
+    // The page sets its own place (all roots) on load; replace it afterwards.
+    this.win.setTimeout(() => (tree.place = toolbarPlace), 0);
+    pageDoc.addEventListener(
+      "MozInputSearch:search",
+      e => {
+        if (e.target.id != "search-box") {
+          return;
+        }
+        e.stopPropagation();
+        if (e.target.value) {
+          tree.applyFilter(e.target.value, [toolbarGuid]);
+        } else {
+          tree.place = toolbarPlace;
+        }
+      },
+      true
+    );
+
+    let closeIfOpened = () => {
+      let node = tree.selectedNode;
+      if (node && lazy.PlacesUtils.nodeIsURI(node)) {
+        this.win.setTimeout(() => this.panel.hidePopup(), 0);
+      }
+    };
+    tree.addEventListener("click", e => {
+      if (
+        e.button < 2 &&
+        e.originalTarget.localName == "treechildren" &&
+        tree.getRowAt(e.clientX, e.clientY) >= 0
+      ) {
+        closeIfOpened();
+      }
+    });
+    tree.addEventListener("keypress", e => {
+      if (e.key == "Enter") {
+        closeIfOpened();
+      }
+    });
+    this.browser.contentDocument?.getElementById("search-box")?.focus();
+  }
+
+  importFromHTML() {
+    let fp = Cc["@mozilla.org/filepicker;1"].createInstance(Ci.nsIFilePicker);
+    fp.init(
+      this.win.browsingContext,
+      lazy.PlacesUIUtils.promptLocalization.formatValueSync(
+        "places-bookmarks-import"
+      ),
+      Ci.nsIFilePicker.modeOpen
+    );
+    fp.appendFilters(Ci.nsIFilePicker.filterHTML);
+    fp.open(result => {
+      if (result == Ci.nsIFilePicker.returnCancel || !fp.fileURL) {
+        return;
+      }
+      lazy.BookmarkHTMLUtils.importFromURL(fp.fileURL.spec, {
+        parentGuid: lazy.PlacesUtils.bookmarks.toolbarGuid,
+      }).catch(console.error);
+    });
+  }
+
+  open(button) {
+    this.button = button;
+    button.setAttribute("aria-expanded", "true");
+    this.panel.openPopup(button, "end_after");
+  }
+}
