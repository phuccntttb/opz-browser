diff --git a/browser/components/sidebar/OpzBookmarksPanel.mjs b/browser/components/sidebar/OpzBookmarksPanel.mjs
new file mode 100644
index 0000000000..9f7c9e381b
--- /dev/null
+++ b/browser/components/sidebar/OpzBookmarksPanel.mjs
@@ -0,0 +1,114 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  PlacesUtils: "resource://gre/modules/PlacesUtils.sys.mjs",
+});
+
+const PANEL_ID = "opz-bookmarks-panel";
+const PAGE = "chrome://browser/content/places/bookmarksSidebar.xhtml";
+
+/**
+ * Opz: the bookmarks sidebar page (search box and bookmark tree) in a panel
+ * anchored to the Bookmarks button at the bottom of the vertical tab column.
+ */
+export class OpzBookmarksPanel {
+  /**
+   * @param {Window} win
+   * @param {Element} button
+   *   Gets aria-expanded while the panel is open.
+   * @param {Element} anchor
+   *   The panel opens at its end edge, bottoms aligned.
+   */
+  static toggle(win, button, anchor) {
+    let panel = win.document.getElementById(PANEL_ID);
+    if (panel && (panel.state == "open" || panel.state == "showing")) {
+      panel.hidePopup();
+      return;
+    }
+    win.opzBookmarksPanel ??= new OpzBookmarksPanel(win);
+    win.opzBookmarksPanel.open(button, anchor);
+  }
+
+  constructor(win) {
+    this.win = win;
+    let doc = win.document;
+
+    this.panel = doc.createXULElement("panel");
+    this.panel.id = PANEL_ID;
+    this.panel.className = "panel-no-padding";
+    this.panel.setAttribute("type", "arrow");
+    this.panel.setAttribute("orient", "vertical");
+    this.panel.setAttribute("role", "dialog");
+    this.panel.style.setProperty("--arrowpanel-padding", "0");
+
+    this.browser = doc.createXULElement("browser");
+    this.browser.setAttribute("disablehistory", "true");
+    this.browser.setAttribute("disablefullscreen", "true");
+    this.browser.setAttribute("autoscroll", "false");
+    this.browser.setAttribute("tooltip", "aHTMLTooltip");
+    this.browser.style.width = "22em";
+    this.browser.style.height = "min(32em, 70vh)";
+    this.browser.setAttribute("src", PAGE);
+    this.panel.append(this.browser);
+    doc.getElementById("mainPopupSet").append(this.panel);
+
+    this.browser.addEventListener(
+      "load",
+      e => {
+        if (e.target.documentURI == PAGE) {
+          this.onPageLoad(e.target);
+        }
+      },
+      true
+    );
+
+    this.panel.addEventListener("popupshown", e => {
+      if (e.target == this.panel) {
+        this.browser.contentDocument?.getElementById("search-box")?.focus();
+      }
+    });
+    this.panel.addEventListener("popuphidden", e => {
+      if (e.target == this.panel) {
+        this.button?.removeAttribute("aria-expanded");
+      }
+    });
+  }
+
+  onPageLoad(pageDoc) {
+    pageDoc.getElementById("sidebar-panel-header").hidden = true;
+    pageDoc.getElementById("sidebar-search-container").style.paddingTop =
+      "var(--space-medium)";
+
+    let tree = pageDoc.getElementById("bookmarks-view");
+    let closeIfOpened = () => {
+      let node = tree.selectedNode;
+      if (node && lazy.PlacesUtils.nodeIsURI(node)) {
+        this.win.setTimeout(() => this.panel.hidePopup(), 0);
+      }
+    };
+    tree.addEventListener("click", e => {
+      if (
+        e.button < 2 &&
+        e.originalTarget.localName == "treechildren" &&
+        tree.getRowAt(e.clientX, e.clientY) >= 0
+      ) {
+        closeIfOpened();
+      }
+    });
+    tree.addEventListener("keypress", e => {
+      if (e.key == "Enter") {
+        closeIfOpened();
+      }
+    });
+    this.browser.contentDocument?.getElementById("search-box")?.focus();
+  }
+
+  open(button, anchor) {
+    this.button = button;
+    button.setAttribute("aria-expanded", "true");
+    this.panel.openPopup(anchor, "end_after");
+  }
+}
