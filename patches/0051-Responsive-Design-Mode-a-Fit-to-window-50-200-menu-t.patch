@@ -0,0 +1,81 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+const {
+  PureComponent,
+} = require("resource://devtools/client/shared/vendor/react.mjs");
+const dom = require("resource://devtools/client/shared/vendor/react-dom-factories.js");
+const PropTypes = require("resource://devtools/client/shared/vendor/react-prop-types.mjs");
+
+const {
+  getStr,
+  getFormatStr,
+} = require("resource://devtools/client/responsive/utils/l10n.js");
+
+loader.lazyRequireGetter(
+  this,
+  "showMenu",
+  "resource://devtools/client/shared/components/menu/utils.js",
+  true
+);
+
+// 0 means "fit to window".
+const SCALE_PRESET = [0, 50, 75, 100, 125, 150, 200];
+
+class ViewportScaleMenu extends PureComponent {
+  static get propTypes() {
+    return {
+      fitScale: PropTypes.number.isRequired,
+      onChangeViewportScale: PropTypes.func.isRequired,
+      viewportScale: PropTypes.number.isRequired,
+    };
+  }
+
+  constructor(props) {
+    super(props);
+    this.onShowMenu = this.onShowMenu.bind(this);
+  }
+
+  onShowMenu(event) {
+    const { onChangeViewportScale, viewportScale } = this.props;
+
+    const menuItems = SCALE_PRESET.map(value => ({
+      label: value
+        ? getFormatStr("responsive.viewportScaleOption", value)
+        : getStr("responsive.viewportScaleFit"),
+      type: "checkbox",
+      checked: viewportScale === value,
+      click: () => onChangeViewportScale(value),
+    }));
+
+    showMenu(menuItems, {
+      button: event.target,
+    });
+  }
+
+  render() {
+    const { fitScale, viewportScale } = this.props;
+
+    const label = viewportScale
+      ? getFormatStr("responsive.viewportScaleOption", viewportScale)
+      : getFormatStr(
+          "responsive.viewportScaleFitLabel",
+          Math.round(fitScale * 100)
+        );
+
+    return dom.button(
+      {
+        id: "viewport-scale-menu",
+        className: "devtools-button devtools-dropdown-button",
+        title: getStr("responsive.changeViewportScale"),
+        onClick: this.onShowMenu,
+      },
+      dom.span({ className: "title" }, label)
+    );
+  }
+}
+
+module.exports = ViewportScaleMenu;
