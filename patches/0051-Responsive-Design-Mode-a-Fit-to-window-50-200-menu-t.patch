+  getViewportScale() {
+    return this.viewportScale ? this.viewportScale / 100 : this.fitScale;
+  }
+
+  /**
+   * Sets --rdm-zoom, how big the viewport is drawn: the tab's own zoom times
+   * the scale picked in the toolbar (or the one that fits the window).
+   */
+  updateViewportScale() {
+    if (!this.browserStackEl) {
+      return;
+    }
+    const zoom = this.tab.linkedBrowser.fullZoom;
+    if (!this.viewportScale) {
+      const { clientWidth, clientHeight } = this.browserStackEl;
+      const width = this.viewportWidth * zoom;
+      const height = this.viewportHeight * zoom;
+      let fit = 1;
+      if (width > 0 && height > 0 && clientWidth > 0 && clientHeight > 0) {
+        fit = Math.min(
+          1,
+          (clientWidth - 30) / width,
+          (clientHeight - 20) / height
+        );
+        fit = Math.max(0.1, Math.floor(fit * 100) / 100);
+      }
+      this.fitScale = fit;
+      this.rdmFrame?.contentWindow?.setFitScale?.(fit * zoom);
+    }
+    this.browserStackEl.style.setProperty(
+      "--rdm-zoom",
+      zoom * this.getViewportScale()
+    );
+  }
+
   /**
