From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Wed, 25 Nov 2026 20:35:49 +0700
Subject: [PATCH] URL bar: a light sweeps under the idle address while the page
 loads

---
 browser/themes/shared/urlbar.css | 45 ++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/browser/themes/shared/urlbar.css b/browser/themes/shared/urlbar.css
index 0d848a0845..7eb671679f 100644
--- a/browser/themes/shared/urlbar.css
+++ b/browser/themes/shared/urlbar.css
@@ -1877,3 +1877,48 @@ toolbar[inactive="true"] .urlbar,
 #urlbar[opz-bookmarks-auto] > .urlbar-input-container > #urlbar-search-mode-indicator {
   display: none;
 }
+
+/* Opz: while the page in the current tab loads (the reload button shows
+ * stop), a light sweeps along a thin line under the idle address. It is in
+ * the address bar's text color, so it follows the theme. */
+:root:has(#reload-button[displaystop]) #urlbar:not([open], [popover-open], [usertyping][focused], [searchmode], [opz-keepopen]):is(:not([focused]), [context-focus]) > .urlbar-input-container {
+  position: relative;
+
+  &::after {
+    content: "";
+    position: absolute;
+    inset-inline: 10px;
+    bottom: 1px;
+    height: 2px;
+    border-radius: 1px;
+    pointer-events: none;
+    background: linear-gradient(to right, transparent, currentColor, transparent) no-repeat;
+    background-size: 35% 100%;
+    animation: opz-urlbar-loading 1.1s ease-in-out infinite;
+  }
+}
+
+@keyframes opz-urlbar-loading {
+  from {
+    background-position: -50% 0;
+  }
+  to {
+    background-position: 150% 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  :root:has(#reload-button[displaystop]) #urlbar > .urlbar-input-container::after {
+    background: currentColor;
+    animation: opz-urlbar-loading-pulse 1.4s ease-in-out infinite alternate;
+  }
+}
+
+@keyframes opz-urlbar-loading-pulse {
+  from {
+    opacity: 0.2;
+  }
+  to {
+    opacity: 0.7;
+  }
+}
