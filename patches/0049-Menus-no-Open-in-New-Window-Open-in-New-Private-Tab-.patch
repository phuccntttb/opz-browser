From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Wed, 25 Nov 2026 17:50:03 +0700
Subject: [PATCH] Menus: no Open in New Window; Open in New Private Tab instead

---
 browser/base/content/browser-context.js       |  2 +-
 browser/base/content/nsContextMenu.sys.mjs    | 36 ++++++++++++-------
 .../components/places/PlacesUIUtils.sys.mjs   | 24 +++++++++++--
 .../places/content/browserPlacesViews.js      |  1 +
 .../content/placesContextMenu.inc.xhtml       | 11 ++----
 .../places/content/placesContextMenu.js       |  3 ++
 .../components/urlbar/content/UrlbarView.mjs  | 11 +-----
 .../locales/en-US/browser/opzPrivateTabs.ftl  |  3 ++
 browser/locales/en-US/browser/places.ftl      |  3 ++
 browser/themes/shared/browser-shared.css      | 15 ++++++++
 10 files changed, 75 insertions(+), 34 deletions(-)

diff --git a/browser/base/content/browser-context.js b/browser/base/content/browser-context.js
index 2e617f91b9..11f70bca99 100644
--- a/browser/base/content/browser-context.js
+++ b/browser/base/content/browser-context.js
@@ -50,7 +50,7 @@ document.addEventListener(
           gContextMenu.openLinkInSplitView(event);
           break;
         case "context-openlinkprivate":
-          gContextMenu.openLinkInPrivateWindow();
+          gContextMenu.openLinkInNewPrivateTab();
           break;
         case "context-openlinksmartwindow":
           gContextMenu.openLinkInSmartWindow();
diff --git a/browser/base/content/nsContextMenu.sys.mjs b/browser/base/content/nsContextMenu.sys.mjs
index ce9e92b961..b1214962d0 100644
--- a/browser/base/content/nsContextMenu.sys.mjs
+++ b/browser/base/content/nsContextMenu.sys.mjs
@@ -533,7 +533,10 @@ export class nsContextMenu {
           this.contentData.userContextId
         )
       ) {
-        document.l10n.setAttributes(item, "opz-private-tab-open-link");
+        document.l10n.setAttributes(
+          item,
+          "opz-private-tab-open-link-in-session"
+        );
       }
     }
 
@@ -547,16 +550,15 @@ export class nsContextMenu {
       "browser.tabs.splitView.enabled"
     );
     let currentTabInSplitView = !!window.gBrowser?.selectedTab?.splitview;
-    let showSmartWindow = lazy.AIWindow.isAIWindowEnabled();
-    this.showItem("context-openlink", shouldShow && !isWindowPrivate);
-    this.showItem(
-      "context-openlinkprivate",
-      shouldShow && lazy.PrivateBrowsingUtils.enabled
-    );
-    this.showItem(
-      "context-openlinksmartwindow",
-      shouldShow && showSmartWindow && !isWindowPrivate
-    );
+    // Opz: no new windows; "context-openlinkprivate" opens a private tab.
+    // Set here: browser/opzPrivateTabs.ftl is added after the window loads.
+    this.showItem("context-openlink", false);
+    document.l10n.setAttributes(
+      document.getElementById("context-openlinkprivate"),
+      "opz-private-tab-open-link"
+    );
+    this.showItem("context-openlinkprivate", shouldShow && !isWindowPrivate);
+    this.showItem("context-openlinksmartwindow", false);
     this.showItem("context-openlinkintab", shouldShow && !inContainer);
     this.showItem("context-openlinkincontainertab", shouldShow && inContainer);
     this.showItem(
@@ -967,7 +969,7 @@ export class nsContextMenu {
     // submenu.
     this.showItem("context-showonlythisframe", !this.inSrcdocFrame);
     this.showItem("context-openframeintab", !this.inSrcdocFrame);
-    this.showItem("context-openframe", !this.inSrcdocFrame);
+    this.showItem("context-openframe", false);
     this.showItem("context-bookmarkframe", !this.inSrcdocFrame);
     this.showItem("context-printframe", lazy.gPrintEnabled);
     this.showItem("print-frame-sep", lazy.gPrintEnabled);
@@ -1596,6 +1598,16 @@ export class nsContextMenu {
     );
   }
 
+  // Opz: open linked-to URL in a new private tab, a new private session.
+  async openLinkInNewPrivateTab() {
+    // contentData is gone once the menu closes; any other container id drops
+    // the referrer.
+    let { window, linkURL } = this;
+    let params = this._openLinkInParameters({ userContextId: -1 });
+    params.userContextId = await lazy.OpzPrivateTabs.allocate();
+    window.openLinkIn(linkURL, "tab", params);
+  }
+
   // Open linked-to URL in a new smart window.
   openLinkInSmartWindow() {
     const params = this._getGlobalHistoryOptions();
diff --git a/browser/components/places/PlacesUIUtils.sys.mjs b/browser/components/places/PlacesUIUtils.sys.mjs
index 16b4b7bf0e..5418223999 100644
--- a/browser/components/places/PlacesUIUtils.sys.mjs
+++ b/browser/components/places/PlacesUIUtils.sys.mjs
@@ -20,6 +20,7 @@ ChromeUtils.defineESModuleGetters(lazy, {
     "moz-src:///browser/components/migration/MigrationUtils.sys.mjs",
   OpenInTabsUtils:
     "moz-src:///browser/components/tabbrowser/OpenInTabsUtils.sys.mjs",
+  OpzPrivateTabs: "resource:///modules/OpzPrivateTabs.sys.mjs",
   PlacesTransactions: "resource://gre/modules/PlacesTransactions.sys.mjs",
   PlacesUtils: "resource://gre/modules/PlacesUtils.sys.mjs",
   PrivateBrowsingUtils: "resource://gre/modules/PrivateBrowsingUtils.sys.mjs",
@@ -1409,8 +1410,7 @@ export var PlacesUIUtils = {
       for (let id of [
         "placesContext_open:newtab",
         "placesContext_open:newcontainertab",
-        "placesContext_open:newwindow",
-        "placesContext_open:newprivatewindow",
+        "placesContext_open:newprivatetab",
       ]) {
         let item = document.getElementById(id);
         item.hidden = this.shouldHideOpenMenuItem(item);
@@ -1540,6 +1540,26 @@ export var PlacesUIUtils = {
     );
   },
 
+  /**
+   * Opz: the context menu's node in a new private tab, a new private session.
+   */
+  async openInPrivateTab() {
+    PlacesUIUtils.lastContextMenuCommand = "placesCmd_open:newprivatetab";
+    let triggerNode = this.lastContextMenuTriggerNode;
+    let window = triggerNode.documentGlobal;
+    let link = triggerNode.closest("#managed-bookmarks") && triggerNode.link;
+    let view = this.getViewForNode(triggerNode);
+    let node = view?.selectedNode || triggerNode;
+    let userContextId = await lazy.OpzPrivateTabs.allocate();
+    if (link) {
+      window.openTrustedLinkIn(link, "tab", { userContextId });
+      return;
+    }
+    this._openNodeIn(node, "tab", view?.ownerWindow || window.top, {
+      userContextId,
+    });
+  },
+
   openSelectionInTabs(event) {
     let isManaged =
       !!event.target.parentNode.triggerNode.closest("#managed-bookmarks");
diff --git a/browser/components/places/content/browserPlacesViews.js b/browser/components/places/content/browserPlacesViews.js
