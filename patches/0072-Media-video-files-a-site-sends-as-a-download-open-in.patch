From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Fri, 27 Nov 2026 14:20:51 +0700
Subject: [PATCH] Media: video files a site sends as a download open in a tab
 and play

Servers often send .mov (and other video) files as application/octet-stream
or with Content-Disposition: attachment, so following the link downloads a
file Gecko can play. Firefox makes this exception only for PDFs, in C++.
OpzInlineVideo watches top-level HTTP responses: when the file name (from
Content-Disposition or the URL) ends in mov, qt, mp4, m4v or webm and the type
is generic or video/*, it sets the video type and an inline disposition before
the loader decides, so the file opens in the video player. Links with the
download attribute and Save Link As still download. Turned off with
opz.media.open_video_attachments_inline = false.
---
 browser/components/BrowserComponents.manifest |   1 +
 browser/modules/OpzInlineVideo.sys.mjs        | 165 ++++++++++++++++++
 browser/modules/moz.build                     |   1 +
 3 files changed, 167 insertions(+)
 create mode 100644 browser/modules/OpzInlineVideo.sys.mjs

diff --git a/browser/components/BrowserComponents.manifest b/browser/components/BrowserComponents.manifest
index f1907ed760..cd343d0e39 100644
--- a/browser/components/BrowserComponents.manifest
+++ b/browser/components/BrowserComponents.manifest
@@ -198,6 +198,7 @@ category browser-first-window-ready resource://gre/modules/SandboxUtils.sys.mjs
 category browser-idle-startup moz-src:///browser/components/places/PlacesUIUtils.sys.mjs PlacesUIUtils.unblockToolbars
 category browser-idle-startup resource:///modules/BuiltInThemes.sys.mjs BuiltInThemes.ensureBuiltInThemes
 category browser-idle-startup resource://gre/modules/RFPHelper.sys.mjs RFPHelper.init
+category browser-before-ui-startup resource:///modules/OpzInlineVideo.sys.mjs OpzInlineVideo.init
 category browser-idle-startup resource:///modules/OpzContainerSync.sys.mjs OpzContainerSync.init
 category browser-idle-startup resource://gre/modules/Blocklist.sys.mjs Blocklist.loadBlocklistAsync
 category browser-idle-startup resource://gre/modules/psm/RemoteSecuritySettings.sys.mjs RemoteSecuritySettings.init
diff --git a/browser/modules/OpzInlineVideo.sys.mjs b/browser/modules/OpzInlineVideo.sys.mjs
new file mode 100644
index 0000000000..e7b353d978
--- /dev/null
+++ b/browser/modules/OpzInlineVideo.sys.mjs
@@ -0,0 +1,165 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Opz: play video files that a site sends as a download.
+ *
+ * Many servers send .mov (and other video) files as
+ * "Content-Type: application/octet-stream" and/or
+ * "Content-Disposition: attachment", so following a link to one downloads it
+ * even though Gecko can play it. Firefox makes this exception only for PDFs
+ * (browser.download.open_pdf_attachments_inline, in C++). Here, before the
+ * loader decides, a top-level page load whose file name ends in a playable
+ * video extension and whose type is generic or video/* gets the video type
+ * and an inline disposition, so it opens in the video player tab instead.
+ *
+ * A link with the download attribute, "Save Link As" and other non-document
+ * loads are left alone, so the user can still choose to save the file.
+ * Turned off with opz.media.open_video_attachments_inline = false.
+ */
+
+import { XPCOMUtils } from "resource://gre/modules/XPCOMUtils.sys.mjs";
+
+const lazy = {};
+XPCOMUtils.defineLazyPreferenceGetter(
+  lazy,
+  "enabled",
+  "opz.media.open_video_attachments_inline",
+  true
+);
+
+const TOPICS = [
+  "http-on-opening-request",
+  "http-on-examine-response",
+  "http-on-examine-cached-response",
+  "http-on-examine-merged-response",
+];
+
+// File extension -> type the media decoders accept.
+const VIDEO_TYPES = new Map([
+  ["mov", "video/quicktime"],
+  ["qt", "video/quicktime"],
+  ["mp4", "video/mp4"],
+  ["m4v", "video/x-m4v"],
+  ["webm", "video/webm"],
+]);
+
+// Types that say nothing about the content, which servers use for downloads.
+const GENERIC_TYPES = new Set([
+  "",
+  "application/octet-stream",
+  "binary/octet-stream",
+  "application/binary",
+  "application/download",
+  "application/force-download",
+  "application/x-download",
+  "application/x-unknown-content-type",
+  "application/unknown",
+  "unknown/unknown",
+]);
+
+function extensionOf(name) {
+  let match = /\.([a-z0-9]{1,5})$/i.exec(name?.trim() || "");
+  return match ? match[1].toLowerCase() : "";
+}
+
+function fileExtension(channel) {
+  try {
+    let ext = extensionOf(channel.contentDispositionFilename);
+    if (ext) {
+      return ext;
+    }
+  } catch (e) {
+    // No Content-Disposition file name; fall back to the URL.
+  }
+  try {
+    return channel.URI.QueryInterface(Ci.nsIURL).fileExtension.toLowerCase();
+  } catch (e) {
+    return "";
+  }
+}
+
+export const OpzInlineVideo = {
+  _initialized: false,
+  // Channels that asked for a download before the response (download attribute).
+  _wantsDownload: new WeakSet(),
+
+  init() {
+    if (this._initialized) {
+      return;
+    }
+    this._initialized = true;
+    for (let topic of TOPICS) {
+      Services.obs.addObserver(this, topic);
+    }
+    Services.obs.addObserver(this, "xpcom-shutdown");
+  },
+
+  observe(subject, topic) {
+    if (topic == "xpcom-shutdown") {
+      for (let t of TOPICS) {
+        Services.obs.removeObserver(this, t);
+      }
+      Services.obs.removeObserver(this, "xpcom-shutdown");
+      return;
+    }
+    if (!lazy.enabled || !(subject instanceof Ci.nsIHttpChannel)) {
+      return;
+    }
+    try {
+      if (topic == "http-on-opening-request") {
+        this._noteDownloadRequest(subject);
+        return;
+      }
+      this._maybeOpenInline(subject);
+    } catch (e) {
+      console.error("OpzInlineVideo:", e);
+    }
+  },
+
+  _isDocumentLoad(channel) {
+    return (
+      channel.loadInfo?.externalContentPolicyType ==
+      Ci.nsIContentPolicy.TYPE_DOCUMENT
+    );
+  },
+
+  _noteDownloadRequest(channel) {
+    if (!this._isDocumentLoad(channel)) {
+      return;
+    }
+    let disposition;
+    try {
+      // Without a response this only answers when a hint was set.
+      disposition = channel.contentDisposition;
+    } catch (e) {
+      return;
+    }
+    if (disposition == Ci.nsIChannel.DISPOSITION_ATTACHMENT) {
+      this._wantsDownload.add(channel);
+    }
+  },
+
+  _maybeOpenInline(channel) {
+    if (!this._isDocumentLoad(channel) || this._wantsDownload.has(channel)) {
+      return;
+    }
+    let status = channel.responseStatus;
+    if (status != 200 && status != 206) {
+      return;
+    }
+    let type = VIDEO_TYPES.get(fileExtension(channel));
+    if (!type) {
+      return;
+    }
+    let current = (channel.contentType || "").toLowerCase();
+    if (!GENERIC_TYPES.has(current) && !current.startsWith("video/")) {
+      return;
+    }
+    if (!current.startsWith("video/")) {
+      channel.contentType = type;
+    }
+    channel.contentDisposition = Ci.nsIChannel.DISPOSITION_FORCE_INLINE;
+  },
+};
