From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Thu, 26 Nov 2026 16:59:17 +0700
Subject: [PATCH] Sidebar: the toolbar's sidebar button pins the tab column
 open

Firefox's sidebar button is back at the start of the nav-bar (older
profiles get it once, opz.customizableui.sidebarButtonRestored). With
vertical tabs a click pins the column open (sidebar.visibility =
always-show) and a second click unpins and collapses it
(expand-on-hover); the button is checked while pinned. It replaces the pin
button at the bottom of the column and the Turn off auto-collapse item in
the tab context menu.
---
 .../customizableui/CustomizableUI.sys.mjs     | 24 ++++++-
 browser/components/sidebar/browser-sidebar.js | 14 +++-
 browser/components/sidebar/sidebar-main.css   | 13 ++--
 browser/components/sidebar/sidebar-main.mjs   | 68 +++++++------------
 .../tabbrowser/content/tab-context-menu.js    | 28 ++------
 browser/locales/en-US/browser/tabbrowser.ftl  |  3 -
 browser/themes/shared/toolbarbuttons.css      |  4 +-
 7 files changed, 71 insertions(+), 83 deletions(-)

diff --git a/browser/components/customizableui/CustomizableUI.sys.mjs b/browser/components/customizableui/CustomizableUI.sys.mjs
index f316b6a254..8fcc89718c 100644
--- a/browser/components/customizableui/CustomizableUI.sys.mjs
+++ b/browser/components/customizableui/CustomizableUI.sys.mjs
@@ -79,7 +79,10 @@ const kPrefOpzAllTabsButtonRemoved =
 // appended to the end of the nav-bar again.
 const kPrefOpzNavBarButtonsRemoved =
   "opz.customizableui.navBarButtonsRemovedV2";
-const kOpzRemovedNavBarButtons = ["sidebar-button", "new-tab-button"];
+const kOpzRemovedNavBarButtons = ["new-tab-button"];
+// Opz: the sidebar button came back as the toggle for pinning the tab column.
+const kPrefOpzSidebarButtonRestored =
+  "opz.customizableui.sidebarButtonRestored";
 
 /**
  * Buttons removed from built-ins by version they were removed. kVersion must be
@@ -369,8 +372,8 @@ var CustomizableUIInternal = {
     );
 
     let navbarPlacements = [
-      // Opz: no sidebar button; the tab column expands on hover and the
-      // panels open from View > Sidebar or their keyboard shortcuts.
+      // Opz: the sidebar button pins the tab column open and unpins it.
+      "sidebar-button",
       "back-button",
       "forward-button",
       "stop-reload-button",
@@ -1120,6 +1123,21 @@ var CustomizableUIInternal = {
       Services.prefs.setBoolPref(kPrefOpzNavBarButtonsRemoved, true);
     }
 
+    // Opz: put the sidebar button back at the start of older profiles'
+    // nav-bar (patch 0019 took it off), once.
+    if (!Services.prefs.getBoolPref(kPrefOpzSidebarButtonRestored, false)) {
+      let navbar = gSavedState.placements?.[CustomizableUI.AREA_NAVBAR];
+      if (
+        Array.isArray(navbar) &&
+        !Object.values(gSavedState.placements).some(
+          ids => Array.isArray(ids) && ids.includes("sidebar-button")
+        )
+      ) {
+        navbar.unshift("sidebar-button");
+      }
+      Services.prefs.setBoolPref(kPrefOpzSidebarButtonRestored, true);
+    }
+
     // Opz: there is no Customize Toolbar to put the downloads button back, and
     // without it the downloads panel has nothing to open from.
     let placements = gSavedState.placements || {};
