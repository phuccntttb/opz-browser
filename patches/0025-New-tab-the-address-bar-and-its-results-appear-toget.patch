From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Thu, 12 Nov 2026 19:02:47 +0700
Subject: [PATCH] New tab: the address bar and its results appear together

---
 browser/base/content/browser-commands.js | 12 ++++++++++--
 browser/themes/shared/urlbar.css         |  5 +++++
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/browser/base/content/browser-commands.js b/browser/base/content/browser-commands.js
index 5ce9b95352..25d5ed59e0 100644
--- a/browser/base/content/browser-commands.js
+++ b/browser/base/content/browser-commands.js
@@ -256,12 +256,20 @@ var BrowserCommands = {
     // whatever is picked opens in a new tab; Escape leaves nothing behind.
     if (!werePassedURL && !searchClipboard && where == "tab") {
       gURLBar.opzOpenInNewTab = true;
+      // Hidden until its results are in, so the bar and the results appear
+      // together; the timeout covers a query with nothing to show.
+      gURLBar.toggleAttribute("opz-newtab", true);
+      let showBar = () => gURLBar.removeAttribute("opz-newtab");
+      let showTimer = setTimeout(showBar, 400);
       gURLBar.inputField.addEventListener(
         "blur",
-        () =>
+        () => {
+          clearTimeout(showTimer);
+          showBar();
           setTimeout(() => {
             gURLBar.opzOpenInNewTab = false;
-          }, 0),
+          }, 0);
+        },
         { once: true }
       );
       gURLBar.search("");
diff --git a/browser/themes/shared/urlbar.css b/browser/themes/shared/urlbar.css
index 7c35e3d2f6..5e4ba2d28d 100644
--- a/browser/themes/shared/urlbar.css
+++ b/browser/themes/shared/urlbar.css
@@ -1786,3 +1786,8 @@ toolbar[inactive="true"] .urlbar,
   z-index: 0;
   -moz-window-dragging: no-drag;
 }
+
+:root:not([customizing]) #urlbar[opz-newtab]:not([open], [popover-open]),
+:root:not([customizing]) #navigator-toolbox:has(#urlbar[opz-newtab]:not([open], [popover-open])) #opz-urlbar-scrim {
+  opacity: 0;
+}
