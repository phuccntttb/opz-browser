From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Opz Browser <opz@localhost>
Date: Wed, 25 Nov 2026 18:15:19 +0700
Subject: [PATCH] Tabs: a spinner while a new tab loads its first page; a
 loading address does not open the URL bar card

---
 .../components/tabbrowser/Tabbrowser.sys.mjs  | 16 +++++++++++
 .../themes/shared/tabbrowser/content-area.css | 27 +++++++++++++++++++
 browser/themes/shared/urlbar.css              | 14 +++++-----
 3 files changed, 50 insertions(+), 7 deletions(-)

diff --git a/browser/components/tabbrowser/Tabbrowser.sys.mjs b/browser/components/tabbrowser/Tabbrowser.sys.mjs
index 1bb6975ae7..e2103ecd19 100644
--- a/browser/components/tabbrowser/Tabbrowser.sys.mjs
+++ b/browser/components/tabbrowser/Tabbrowser.sys.mjs
@@ -10641,6 +10641,14 @@ class TabProgressListener {
           this._tab.setAttribute("busy", "true");
           this.#tabbrowser._tabAttrModified(this._tab, ["busy"]);
           this._tab._notselectedsinceload = !this._tab.selected;
+          // Opz: a spinner over a blank page until the new page arrives.
+          if (
+            this.#documentGlobal.isBlankPageURL(
+              this._browser.currentURI?.spec || "about:blank"
+            )
+          ) {
+            this._browser.parentNode.toggleAttribute("opz-loading", true);
+          }
         }
 
         if (this._tab.selected) {
@@ -10651,6 +10659,7 @@ class TabProgressListener {
       // since we (try to) only handle STATE_STOP of the last request,
       // the count of open requests should now be 0
       this._requestCount = 0;
+      this._browser.parentNode.removeAttribute("opz-loading");
 
       let modifiedAttrs = [];
       if (this._tab.hasAttribute("busy")) {
@@ -10824,6 +10833,13 @@ class TabProgressListener {
         this.#tabbrowser._tabAttrModified(this._tab, ["busy"]);
       }
 
+      if (
+        !isSameDocument &&
+        !this.#documentGlobal.isBlankPageURL(aLocation.spec)
+      ) {
+        this._browser.parentNode.removeAttribute("opz-loading");
+      }
+
       if (!isSameDocument) {
         // If the browser was playing audio, we should remove the playing state.
         if (this._tab.hasAttribute("soundplaying")) {
diff --git a/browser/themes/shared/tabbrowser/content-area.css b/browser/themes/shared/tabbrowser/content-area.css
index 837f602186..925685df80 100644
--- a/browser/themes/shared/tabbrowser/content-area.css
+++ b/browser/themes/shared/tabbrowser/content-area.css
@@ -1130,3 +1130,30 @@ split-view-footer {
 #window-modal-dialog > .dialogOverlay[topmost="true"] {
   background-color: transparent;
 }
+
+/* Opz: a spinner over a blank page while a tab loads its first page. */
+.browserStack[opz-loading] {
+  position: relative;
+
+  &::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: 1;
+    margin: auto;
+    width: 28px;
+    height: 28px;
+    box-sizing: border-box;
+    border: 3px solid rgb(128 128 128 / 0.25);
+    border-top-color: rgb(128 128 128 / 0.9);
+    border-radius: 50%;
+    pointer-events: none;
+    animation: opz-content-spin 0.8s linear infinite;
+  }
+}
+
+@keyframes opz-content-spin {
+  to {
+    transform: rotate(1turn);
+  }
+}
