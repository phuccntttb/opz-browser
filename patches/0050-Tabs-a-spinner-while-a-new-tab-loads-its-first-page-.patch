-:root:not([customizing]) #navigator-toolbox #urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping], [searchmode], [opz-keepopen]) {
+:root:not([customizing]) #navigator-toolbox #urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping][focused], [searchmode], [opz-keepopen]) {
   animation: opz-urlbar-in 180ms ease-out;
 
   @media (prefers-reduced-motion) {
@@ -1833,7 +1833,7 @@ toolbar[inactive="true"] .urlbar,
  * information / permissions on the left, page actions on the right) are
