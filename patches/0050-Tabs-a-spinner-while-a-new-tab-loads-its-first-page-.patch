-:root:not([customizing]) #urlbar:not([open], [popover-open], [usertyping], [searchmode], [opz-keepopen]):is(:not([focused]), [context-focus]) {
+:root:not([customizing]) #urlbar:not([open], [popover-open], [usertyping][focused], [searchmode], [opz-keepopen]):is(:not([focused]), [context-focus]) {
   & #identity-box,
   & #page-action-buttons {
     opacity: 0;
