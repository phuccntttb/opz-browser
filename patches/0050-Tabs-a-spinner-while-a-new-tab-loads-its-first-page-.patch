 :root:not([customizing]) {
-  #urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping], [searchmode], [opz-keepopen]) {
+  #urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping][focused], [searchmode], [opz-keepopen]) {
     --urlbar-height: 44px;
     --urlbar-background-overhang-open: 8px;
     /* These are worked out on :root from the values there, so they are
@@ -1757,7 +1757,7 @@ toolbar[inactive="true"] .urlbar,
     }
   }
 
-  #navigator-toolbox:has(#urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping], [searchmode], [opz-keepopen])) {
+  #navigator-toolbox:has(#urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping][focused], [searchmode], [opz-keepopen])) {
     z-index: 10;
 
     /* The bar's own shadow dims the window, so it paints under the bar and
@@ -1779,7 +1779,7 @@ toolbar[inactive="true"] .urlbar,
   display: none;
 }
 
-:root:not([customizing]) #navigator-toolbox:has(#urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping], [searchmode], [opz-keepopen])) > #opz-urlbar-scrim {
+:root:not([customizing]) #navigator-toolbox:has(#urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping][focused], [searchmode], [opz-keepopen])) > #opz-urlbar-scrim {
   display: block;
   position: fixed;
   inset: 0;
@@ -1792,7 +1792,7 @@ toolbar[inactive="true"] .urlbar,
   transition: filter 180ms ease-out;
 }
 
-:root:not([customizing]):has(#urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping], [searchmode], [opz-keepopen])):not(:has(#urlbar[opz-newtab]:not([open], [popover-open]))) #browser {
+:root:not([customizing]):has(#urlbar:is([focused]:not([context-focus]), [open], [popover-open], [usertyping][focused], [searchmode], [opz-keepopen])):not(:has(#urlbar[opz-newtab]:not([open], [popover-open]))) #browser {
   filter: blur(10px);
 }
 
@@ -1805,7 +1805,7 @@ toolbar[inactive="true"] .urlbar,
 /* The card, its dimming shadow and its results fade in. While a New Tab waits
  * for its results the card is hidden and has no animation, which starts when
